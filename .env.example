# Copy this file to .env.local and fill in your LOCAL (dev) Supabase credentials.
# Production credentials live only in Vercel → Settings → Environment Variables.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Local:      use your dayflow-dev project
# Production: set dayflow-prod credentials in Vercel dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key

# ─── App URL ──────────────────────────────────────────────────────────────────
# Local:      http://localhost:3000
# Production: set https://dayflow-self-sigma.vercel.app in Vercel dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Environment label ────────────────────────────────────────────────────────
# Always 'development' locally. Vercel production sets this to 'production'.
NEXT_PUBLIC_ENV=development

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Currently disabled in lib/email.ts until a custom domain is set up.
# When ready: add your Resend key here locally and in Vercel for production.
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM_EMAIL=DayFlow <notifications@yourdomain.com>

# ─── Billing (server-side) ────────────────────────────────────────────────────
# Service role key — used by webhook routes only (entitlement reads, upserts).
# Never expose to the client. Pull from Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Stripe (web subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# RevenueCat (Android via Play Billing)
# Set this to the same value configured under RevenueCat → Integrations → Webhooks → Authorization header.
REVENUECAT_WEBHOOK_SECRET=your-shared-secret

# ─── Billing (public — safe in client bundle) ─────────────────────────────────
# Web (Stripe) billing kill-switch. Unset/0 = web hides Stripe checkout & portal
# and points users to Google Play (Android buys via Play Billing/RevenueCat).
# Set to 1 only once a live Stripe account exists. See docs/prod-launch.md §2.
NEXT_PUBLIC_ENABLE_WEB_BILLING=0
# Stripe Price IDs for each SKU (created in Stripe dashboard → Products).
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL=price_...
NEXT_PUBLIC_STRIPE_PRICE_LIFETIME=price_...
# RevenueCat public SDK key — different keys per platform (Android vs iOS).
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
# NEXT_PUBLIC_REVENUECAT_IOS_KEY=appl_...

# ─── Analytics (PostHog) ──────────────────────────────────────────────────────
# Project API key from PostHog → Project Settings → General (starts with phc_).
# Leave blank to disable analytics entirely — the wrapper silently no-ops.
# Server-side webhook events use the same public key (PostHog accepts it for
# server captures; there's no separate "secret" key).
NEXT_PUBLIC_POSTHOG_KEY=
# Web bypasses this and hits the /ingest reverse proxy configured in
# next.config.js — defeats tracker blockers (Firefox ETP, uBlock, Brave Shields).
# This URL is used only by the native Capacitor client and by server-side
# webhook events. Change to https://eu.i.posthog.com if your PostHog project
# lives in the EU cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Error tracking (Sentry) ──────────────────────────────────────────────────
# DSN from Sentry → Project → Settings → Client Keys (DSN). Public — safe to
# expose in the client bundle. Leave blank to disable error capture entirely.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload (production builds only). Create at Sentry → User Auth Tokens
# with `project:releases` + `org:read` scopes. Keep server-side, never expose.
# SENTRY_AUTH_TOKEN=sntrys_...
# Required by withSentryConfig for source-map upload — find under Sentry → Settings.
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=dayflow

# ─── Ads (AdMob — Android only) ───────────────────────────────────────────────
# Banner ad-unit id. Find under AdMob → app → Ad units. Leave blank to fall
# back to Google's always-fill test banner (so dev/preview builds don't serve
# real ads). The matching APPLICATION_ID lives in android/app/src/main/AndroidManifest.xml
# as a <meta-data> tag — that one is build-time, not runtime, so swap it
# there before each release.
NEXT_PUBLIC_ADMOB_BANNER_AD_ID=
