# Copy this file to .env.local and fill in your LOCAL (dev) Supabase credentials.
# Production credentials live only in Vercel → Settings → Environment Variables.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Local:      use your dayflow-dev project
# Production: set dayflow-prod credentials in Vercel dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key

# ─── App URL ──────────────────────────────────────────────────────────────────
# Local:      http://localhost:3000
# Production: set https://dayflow-self-sigma.vercel.app in Vercel dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Environment label ────────────────────────────────────────────────────────
# Always 'development' locally. Vercel production sets this to 'production'.
NEXT_PUBLIC_ENV=development

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Currently disabled in lib/email.ts until a custom domain is set up.
# When ready: add your Resend key here locally and in Vercel for production.
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM_EMAIL=DayFlow <notifications@yourdomain.com>
