<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">DayFlow</string>
    <string name="title_activity_main">DayFlow</string>
    <string name="package_name">com.chanclastudio.dayflow</string>
    <string name="custom_url_scheme">com.chanclastudio.dayflow</string>
    <string name="widget_label">DayFlow — Hoy</string>
    <string name="widget_description">Mira tus tareas de hoy y márcalas como completadas desde la pantalla de inicio.</string>
    <!-- Default notification channel id. Used by FCM when a push arrives
         with a channel_id that doesn't exist on this device (e.g. activity-
         alarms before the app has ever opened the dashboard). Falling back
         to activity-reminders (HIGH importance) is much better than Android's
         generic "Miscellaneous" channel (DEFAULT importance, quiet vibrate). -->
    <string name="default_notification_channel_id">activity-reminders</string>
    <string name="streak_widget_label">DayFlow — Racha</string>
    <string name="streak_widget_description">Tu racha actual y el progreso de hoy a la vista.</string>
    <string name="nextup_widget_label">DayFlow — Próxima</string>
    <string name="nextup_widget_description">Tu próxima actividad y cuánto falta para empezar.</string>
    <string name="day_widget_label">DayFlow — Día</string>
    <string name="day_widget_description">El día actual con sus actividades a un vistazo.</string>
    <string name="agenda_widget_label">DayFlow — Agenda</string>
    <string name="agenda_widget_description">Hoy y los próximos 2 días en un solo widget.</string>
    <!--
      Daily-summary tray notification strings. Default (values/) is English
      so the user-pasted reference screenshot's tone matches what most
      English-speaking users see; values-es/ overrides for Spanish locales.
    -->
    <string name="daily_summary_channel_name">Daily summary</string>
    <string name="daily_summary_channel_description">Always-pinned summary of today\'s activities</string>
    <string name="daily_summary_body_zero">No event today</string>
    <string name="daily_summary_body_one">1 event today</string>
    <!-- Plural-N case; %1$d is the count. -->
    <string name="daily_summary_body_many">%1$d events today</string>
    <string name="daily_summary_action_task">+ Task</string>
    <string name="daily_summary_action_reminder">+ Reminder</string>
</resources>
