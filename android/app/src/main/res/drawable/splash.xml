<?xml version="1.0" encoding="utf-8"?>
<!--
  No-qualifier fallback for R.drawable.splash. On any real device, the
  Android resource resolver will pick a density-qualified splash.png
  (drawable-{port,land}[-night]-{ldpi..xxxhdpi}/splash.png — all generated
  by play-store/generate-splash.py from assets/icon.png) before this file.

  This XML only kicks in for unusual configurations where no qualified PNG
  matches; it deliberately doesn't reference @drawable/splash to avoid
  resource-name recursion. It just shows the launcher icon centered on the
  splash background as a safe baseline.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/splash_background"/>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher"/>
    </item>
</layer-list>
