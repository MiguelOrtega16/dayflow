<?xml version="1.0" encoding="utf-8"?>
<!--
  Real widget layout (used after onUpdate swaps it in over the static
  preview). Kept deliberately free of:
    - <ImageView>/<ImageButton> + vector drawable src   (broken on Samsung One UI)
    - <View> with shape drawable as backdrop             (works pre-API 31 only)
    - ?android:attr/... theme attributes                 (don't always resolve in widgets)
    - <shape>/<vector> drawables as backgrounds          (replaced with inline colors)
  Provider still calls setBackgroundColor on widget_bg / widget_header to
  apply per-widget tinting; both IDs are present below.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="6dp"
        android:background="#7C6FE3">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DayFlow"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_btn_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:contentDescription="Nueva tarea" />

        <TextView
            android:id="@+id/widget_btn_config"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:contentDescription="Configurar" />
    </LinearLayout>

    <!-- Activity list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="20dp"
            android:textColor="#666666"
            android:textSize="15sp"
            android:text="Sin actividades para hoy.\nAbre la app para crear una."
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
