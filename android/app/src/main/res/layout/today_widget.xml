<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="6dp">

    <!-- Background tinted by config (color + opacity) -->
    <View
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header bar: title + refresh + configure -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:background="@drawable/widget_header_bg">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DayFlow"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/widget_btn_refresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_widget_refresh"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Actualizar"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/widget_btn_config"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_widget_settings"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Configurar"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- Activity list -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/widget_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/widget_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="20dp"
                android:textColor="#666666"
                android:textSize="13sp"
                android:text="Sin actividades para hoy.\nAbre la app para crear una."
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
