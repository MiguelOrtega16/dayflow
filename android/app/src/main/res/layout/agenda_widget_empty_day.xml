<?xml version="1.0" encoding="utf-8"?>
<!--
  Variant row used for days with no scheduled activities. Same date column
  layout as the populated row, but the right side is a single muted "Sin
  actividades" line instead of a coloured event block — so the agenda
  visibly spans the full 3-day window even on quiet days.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/agenda_empty_dow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/agenda_empty_dom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="18sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/agenda_empty_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:text="Sin actividades"
        android:textColor="#888888"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
