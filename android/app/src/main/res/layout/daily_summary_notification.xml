<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom collapsed/expanded content view for the always-pinned daily-
  summary tray entry. Wraps title + body + two inline action buttons so
  the + Task / + Reminder shortcuts are visible without the user having
  to expand the notification (Samsung One UI hides standard actions in
  the collapsed view, which is the exact problem this layout solves).

  Designed to work inside Notification.DecoratedCustomViewStyle, which
  draws the system header (app icon, app name, time, expand arrow)
  above and lets us own the rest of the layout. Theme attrs adapt the
  text colours to the system's light/dark notification panel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/summary_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/summary_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Inline button row. The TextViews are tap targets — the provider
         attaches PendingIntents to each one via setOnClickPendingIntent
         on the RemoteViews. Selectable item background draws the ripple
         on press so it visually reads as a button. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/summary_btn_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="?android:attr/colorAccent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/summary_btn_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="?android:attr/colorAccent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>
</LinearLayout>
