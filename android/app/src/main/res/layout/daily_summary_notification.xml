<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom content view for the always-pinned daily-summary tray entry.

  Sizing trade-off: Android's compact notification view clips at ~64dp
  on most launchers (Samsung One UI included). Stacking title + body
  + button-row vertically (~85dp) made the system clip the button row
  in the collapsed state — the exact bug the user reported. To keep
  both + buttons visible without the user having to expand the
  notification, we merge the date and the event count into ONE title
  line and place the button row directly under it. Total height is
  now ~58dp, comfortably under the compact limit.

  Text appearance still uses androidx.core's Notification.Title style,
  which adapts to light/dark system notification panels so the title
  doesn't render at 50% opacity on Samsung's translucent dark shade.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="2dp"
    android:paddingEnd="12dp"
    android:paddingTop="0dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/summary_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:singleLine="true"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="-6dp">

        <TextView
            android:id="@+id/summary_btn_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textColor="#7C6FE3"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/summary_btn_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:minHeight="32dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textColor="#7C6FE3"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:background="?android:attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>
</LinearLayout>
