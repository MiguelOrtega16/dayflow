<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Circle indicator: ○ when pending, ● when done. Drawn as text so the
         RemoteViews renderer doesn't need to inflate a vector drawable.
         Sized for a comfortable tap target (~48dp+ including row padding). -->
    <TextView
        android:id="@+id/item_circle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="○"
        android:textSize="30sp"
        android:textColor="#888888"
        android:contentDescription="Marcar como completado" />

    <TextView
        android:id="@+id/item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="#666666"
        android:textSize="13sp" />
</LinearLayout>
