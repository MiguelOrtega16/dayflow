<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Status indicator: thin-stroke circle when pending, filled circle with
         check when done. Uses vector drawables instead of Unicode glyphs so the
         visible shape actually fills its bounds (text glyphs only cover ~60% of
         the text box and look undersized for the available row space). Matches
         the lucide Circle/CheckCircle2 used in the day-detail panel. -->
    <ImageView
        android:id="@+id/item_circle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="2dp"
        android:src="@drawable/ic_widget_circle"
        android:scaleType="fitCenter"
        android:contentDescription="Marcar como completado" />

    <TextView
        android:id="@+id/item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="#666666"
        android:textSize="13sp" />
</LinearLayout>
