<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher"
        />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary"
        />
        <!-- Fallback channel for FCM pushes whose channel_id isn't registered
             on the device. Without this, Android creates a "Miscellaneous"
             channel at IMPORTANCE_DEFAULT, which made alarm-type reminders
             look identical to plain notifications when the activity-alarms
             channel hadn't been created yet. Value matches the id created
             by ensureReminderChannels in lib/push-notifications.ts. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="activity-reminders"
        />

        <!-- Google AdMob — required for the SDK to initialize without crashing
             the app on launch. The value below is Google's official sample
             "test app" ID; REPLACE it with the real AdMob App ID from
             https://apps.admob.com/ before the next Play Store release. The
             corresponding banner ad-unit id lives in NEXT_PUBLIC_ADMOB_BANNER_AD_ID.
             See https://developers.google.com/admob/android/quick-start. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3058570787981966/6330046141"
        />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- ── Home-screen widgets ── -->
        <receiver android:name=".widget.TodayWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver android:name=".widget.StreakWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/streak_widget_info" />
        </receiver>

        <receiver android:name=".widget.NextUpWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.chanclastudio.dayflow.NEXTUP_TICK" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/nextup_widget_info" />
        </receiver>

        <receiver android:name=".widget.DayWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/day_widget_info" />
        </receiver>

        <receiver android:name=".widget.AgendaWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_widget_info" />
        </receiver>

        <receiver android:name=".widget.WidgetActionReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.chanclastudio.dayflow.widget.REFRESH" />
                <action android:name="com.chanclastudio.dayflow.widget.ROW_CLICK" />
            </intent-filter>
        </receiver>

        <!-- Daily summary tray entry — re-posted on boot (so it survives a
             reboot) and on midnight (so the date label rolls over). -->
        <receiver android:name=".summary.DailySummaryReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.chanclastudio.dayflow.SUMMARY_MIDNIGHT" />
            </intent-filter>
        </receiver>

        <!--
          android:exported="true" is required so the system AppWidgetHost
          (which lives in a different process / UID) can bind to this
          RemoteViewsService. It's still secured by BIND_REMOTEVIEWS,
          which is a signature|privileged permission only the system holds.
          See https://developer.android.com/reference/android/widget/RemoteViewsService
        -->
        <service
            android:name=".widget.TodayWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="true"
        />
        <service
            android:name=".widget.AgendaWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="true"
        />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for exact local notification alarms (bypasses Doze mode on Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-schedules alarms after device reboot (otherwise all pending notifications are lost) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Google Play Billing — required for in-app purchases / subscriptions -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Advertising ID — required by Google whenever the Play Console
         Advertising ID declaration says "yes, uses ad ID" AND the app targets
         Android 13 (API 33) or later. Without it the system zeroes out the
         ID at runtime regardless of what the SDK requests, which would
         silently break AdMob fill rate once we re-enable ads. Even though
         the SDK is dormant today, the permission must match the listing
         declaration to clear the Play Console pre-launch report. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
</manifest>
